{
  "_comment": "Registry of agent hosts that load SKILL.md skills. '~' paths are user-level, others are relative to a project root. A root listed under several hosts is shared. Add a host here to teach the scanner about it; no code change needed. Snapshot 2026-10-27; see references/hosts/*.md for sources.",
  "hosts": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "binaries": [
        "claude"
      ],
      "apps": [
        "Claude.app"
      ],
      "ide_extensions": [
        "anthropic.claude-code"
      ],
      "config_dirs": [
        "~/.claude"
      ],
      "user_skill_dirs": [
        "~/.claude/skills"
      ],
      "project_skill_dirs": [
        ".claude/skills"
      ],
      "managed_skill_dirs": [
        "~/.claude/skills/synced/*"
      ],
      "plugin_manifest": "~/.claude/plugins/installed_plugins.json",
      "version_cmd": [
        "claude",
        "--version"
      ],
      "reference": "hosts/claude-code.md"
    },
    {
      "id": "codex",
      "name": "OpenAI Codex",
      "binaries": [
        "codex"
      ],
      "apps": [
        "Codex.app"
      ],
      "ide_extensions": [
        "openai.chatgpt"
      ],
      "config_dirs": [
        "~/.codex"
      ],
      "user_skill_dirs": [
        "~/.agents/skills",
        "~/.codex/skills",
        "/etc/codex/skills"
      ],
      "project_skill_dirs": [
        ".agents/skills",
        ".codex/skills"
      ],
      "managed_skill_dirs": [
        "~/.codex/skills/.system"
      ],
      "plugin_skill_dirs": [
        "~/.codex/plugins/*/skills"
      ],
      "version_cmd": [
        "codex",
        "--version"
      ],
      "reference": "hosts/codex.md"
    },
    {
      "id": "gemini-cli",
      "name": "Gemini CLI",
      "binaries": [
        "gemini"
      ],
      "apps": [],
      "ide_extensions": [
        "google.gemini-cli-vscode-ide-companion"
      ],
      "config_dirs": [
        "~/.gemini"
      ],
      "user_skill_dirs": [
        "~/.gemini/skills",
        "~/.agents/skills"
      ],
      "project_skill_dirs": [
        ".gemini/skills",
        ".agents/skills"
      ],
      "managed_skill_dirs": [],
      "version_cmd": [
        "gemini",
        "--version"
      ],
      "reference": "hosts/gemini-cli.md"
    },
    {
