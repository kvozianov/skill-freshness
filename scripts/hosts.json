        "~/.gemini/antigravity"
      ],
      "user_skill_dirs": [
        "~/.gemini/config/skills",
        "~/.gemini/antigravity-cli/skills",
        "~/.gemini/antigravity/skills"
      ],
      "project_skill_dirs": [
        ".agents/skills",
        ".agent/skills"
      ],
      "managed_skill_dirs": [
        "~/.gemini/antigravity/builtin/skills"
      ],
      "version_cmd": null,
      "reference": "hosts/antigravity.md",
      "plugin_skill_dirs": [
        "~/.gemini/config/plugins/*/skills",
        "~/.gemini/antigravity-cli/plugins/*/skills"
      ]
    },
